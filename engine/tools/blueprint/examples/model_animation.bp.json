{
  "version": 1,
  "name": "BP_ModelAnimation",
  "kind": "Behaviour",
  "variables": [],
  "graphs": [
    {
      "kind": "event",
      "name": "update",
      "nodes": [
        {
          "id": "entry",
          "kind": "entry",
          "x": 20,
          "y": 60,
          "defaults": {}
        },
        {
          "id": "self",
          "kind": "self",
          "x": 20,
          "y": 260,
          "defaults": {}
        },
        {
          "id": "machine",
          "kind": "stateMachine",
          "x": 300,
          "y": 60,
          "defaults": {},
          "mode": "model",
          "initial": "Idle",
          "states": [
            {
              "name": "Idle",
              "clip": "idle",
              "loop": true,
              "blend": 0.2,
              "speed": 1
            },
            {
              "name": "Move",
              "clip": "walk",
              "loop": true,
              "blend": 0.25,
              "speed": 1.3
            }
          ],
          "transitions": [
            {
              "name": "Go",
              "from": "Idle",
              "to": "Move"
            },
            {
              "name": "Stop",
              "from": "Move",
              "to": "Idle"
            }
          ]
        }
      ],
      "links": [
        {
          "from": {
            "node": "entry",
            "pin": "then"
          },
          "to": {
            "node": "machine",
            "pin": "in"
          }
        },
        {
          "from": {
            "node": "entry",
            "pin": "dt"
          },
          "to": {
            "node": "machine",
            "pin": "dt"
          }
        },
        {
          "from": {
            "node": "self",
            "pin": "value"
          },
          "to": {
            "node": "machine",
            "pin": "target"
          }
        }
      ]
    }
  ]
}
